{
  "permissions": {
    "allow": [
      "Bash(devflow-evo:*)",
      "Read",
      "Write",
      "Edit"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ${DEVFLOW_EVO_HOME}/adapters/shared/core-bridge.js startup",
        "description": "Load devflow-evo project state and memory on session start"
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node ${DEVFLOW_EVO_HOME}/adapters/shared/core-bridge.js pre-prompt",
        "description": "Inject current phase context before prompt processing"
      }
    ]
  }
}
